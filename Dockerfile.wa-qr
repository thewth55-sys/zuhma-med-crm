# Second Easypanel service, same repo — builds only services/wa-qr-gateway/,
# the standalone Baileys (unofficial WhatsApp Web / QR) gateway process.
# See supabase/migrations/115_whatsapp_qr_provider.sql and the Fase 1 plan
# for why this is a separate long-running process instead of a Next.js
# route: a Baileys session needs a persistent WebSocket, which an HTTP
# request/response route can't hold open between requests.
#
# Debian-based (not alpine, unlike the main Dockerfile) because `sharp`
# (a required Baileys peer dependency) needs glibc's prebuilt binaries —
# musl (alpine) prebuilds exist too, but this avoids the extra libc6-compat
# shims the main Dockerfile needs and keeps this image's dependency surface
# closer to what actually gets tested locally.
#
# Node 22, not 20: this Baileys version (7.0.0-rc14) requires the native
# `WebSocket` global, which only ships stable (unflagged) from Node 22 —
# on Node 20 it throws "Node.js detected but native WebSocket not found"
# the moment a session tries to connect. Confirmed against the deployed
# service before this was found.
FROM node:22-slim AS deps
WORKDIR /app
COPY services/wa-qr-gateway/package.json services/wa-qr-gateway/package-lock.json* ./
RUN npm ci

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY services/wa-qr-gateway/ .
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs gateway

COPY --from=builder --chown=gateway:nodejs /app/dist ./dist
COPY --from=deps --chown=gateway:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=gateway:nodejs /app/package.json ./package.json

USER gateway

EXPOSE 3100
ENV PORT=3100

CMD ["node", "dist/index.js"]
