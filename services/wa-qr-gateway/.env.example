# Separate container/service from the main app — these are NOT read
# from the monolith's .env. Set them directly on this service in
# Easypanel (or wherever it's deployed).

# Supabase project — SAME project as the main app. This service reads/
# writes whatsapp_config directly with the service-role key (bypasses
# RLS), same as the monolith's own admin client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# MUST be the exact same value as the main app's ENCRYPTION_KEY (64 hex
# chars = 32 bytes, AES-256-GCM) — this service encrypts qr_auth_state
# with it and the main app never needs to decrypt that column itself,
# but they still need to agree on the key so a key rotation on one side
# doesn't silently orphan the other's ciphertext.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Shared secret this service checks on every inbound request (as
# `x-qr-gateway-secret`). MUST match WA_QR_GATEWAY_SECRET on the main
# app. Generate with: openssl rand -hex 32
WA_QR_GATEWAY_SECRET=generate-a-long-random-string

# Where this service POSTs inbound messages. The main app's own origin
# plus /api/whatsapp/qr-webhook, e.g. https://medcrm.zuhma.online/api/whatsapp/qr-webhook
MONOLITH_QR_WEBHOOK_URL=https://your-app.example.com/api/whatsapp/qr-webhook

# Shared secret sent as `x-qr-webhook-secret` on that POST. MUST match
# WA_QR_WEBHOOK_SECRET on the main app. Generate with: openssl rand -hex 32
WA_QR_WEBHOOK_SECRET=generate-a-long-random-string

# HTTP port this service listens on. Default 3100.
# PORT=3100

# pino log level (trace/debug/info/warn/error/fatal). Default info.
# LOG_LEVEL=info
